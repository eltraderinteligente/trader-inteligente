---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BlogPost from '../../../components/pages/BlogPost.astro';
import { getPosts, slugOf, findTranslationSlug } from '../../../lib/content';

interface Props {
  entry: CollectionEntry<'blog'>;
  counterpartSlug?: string;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts('en');
  return Promise.all(
    posts.map(async (entry) => ({
      params: { slug: slugOf(entry) },
      props: {
        entry,
        counterpartSlug: await findTranslationSlug(
          'blog',
          entry.data.translationKey,
          'es',
        ),
      },
    })),
  );
};

const { entry, counterpartSlug } = Astro.props;
---

<BlogPost entry={entry} locale="en" counterpartSlug={counterpartSlug} />
