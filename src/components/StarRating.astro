---
import type { Locale } from '../config/site';
import { useTranslations } from '../i18n/utils';

interface Props {
  rating: number;
  locale: Locale;
}

const { rating, locale } = Astro.props;
const t = useTranslations(locale);

const STARS = [1, 2, 3, 4, 5];
const label = `${t('reviews.ratingLabel')}: ${rating} ${t('reviews.outOf')}`;
---

{/* Stars are decorative; the rating is announced once, as text. */}
<p class="flex items-center gap-1" aria-label={label}>
  {
    STARS.map((n) => (
      <svg
        aria-hidden="true"
        viewBox="0 0 20 20"
        class:list={[
          'h-4 w-4',
          n <= rating ? 'fill-accent' : 'fill-line-strong',
        ]}
      >
        <path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8-5.3-2.8-5.3 2.8 1-5.8L1.5 7.7l5.9-.9L10 1.5z" />
      </svg>
    ))
  }
  <span class="sr-only">{label}</span>
</p>
