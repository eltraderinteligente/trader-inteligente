---
import { LOCALES, type Locale } from '../config/site';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  /** This page's URL in every language, passed down from BaseLayout. */
  alternates: Record<Locale, string>;
}

const { alternates } = Astro.props;
const current = getLocaleFromUrl(Astro.url);
const t = useTranslations(current);
---

<nav aria-label={t('language.label')} class="flex items-center gap-1 text-sm">
  {
    LOCALES.map((locale, i) => (
      <>
        {i > 0 && <span aria-hidden="true" class="text-line-strong">/</span>}
        {locale === current ? (
          <span aria-current="true" class="text-heading font-semibold">
            {locale.toUpperCase()}
          </span>
        ) : (
          <a
            href={alternates[locale]}
            hreflang={locale}
            lang={locale}
            rel="alternate"
            data-lang-choice={locale}
            class="text-muted hover:text-heading hover:decoration-accent underline-offset-4 transition-colors hover:underline"
          >
            {locale.toUpperCase()}
          </a>
        )}
      </>
    ))
  }
</nav>

{/*
  Clicking ES or EN is somebody telling the site what they want, so it is
  remembered and the homepage stops guessing from then on. Without this, a
  Spanish speaker on an English laptop would be sent back to English on every
  single visit, no matter how many times they switched.
*/}
<script>
  import { LANG_PREFERENCE_KEY } from '../config/language';

  for (const link of document.querySelectorAll<HTMLElement>(
    '[data-lang-choice]'
  )) {
    link.addEventListener('click', () => {
      const choice = link.dataset.langChoice;
      if (!choice) return;
      try {
        localStorage.setItem(LANG_PREFERENCE_KEY, choice);
      } catch {
        // Nothing to do if storage is blocked; detection simply continues.
      }
    });
  }
</script>
