---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../config/site';
import { useTranslations, formatDate, isoDate } from '../../i18n/utils';
import { route, dynamicRoute } from '../../i18n/routes';

interface Props {
  entry: CollectionEntry<'blog'>;
  locale: Locale;
  /** Slug of the same post in the other language, when it exists. */
  counterpartSlug?: string;
}

const { entry, locale, counterpartSlug } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(entry);

const other: Locale = locale === 'es' ? 'en' : 'es';
const slug = entry.id.split('/').pop()!;

// If the post has not been translated yet, point the switcher at that
// language's blog index rather than a URL that would 404.
const alternates = {
  [locale]: dynamicRoute('blogPost', locale, slug),
  [other]: counterpartSlug
    ? dynamicRoute('blogPost', other, counterpartSlug)
    : route('blog', other),
} as Record<Locale, string>;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  alternates={alternates}
>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:py-24">
    <a
      href={route('blog', locale)}
      class="link-quiet text-sm underline"
    >
      &larr; {t('blog.backToBlog')}
    </a>

    <h1 class="mt-8 text-3xl font-semibold sm:text-4xl">{entry.data.title}</h1>

    <p class="text-muted mt-5 text-sm">
      <time datetime={isoDate(entry.data.pubDate)}>
        {formatDate(entry.data.pubDate, locale)}
      </time>
      <span aria-hidden="true"> · </span>
      {t('blog.by')} {entry.data.author}
      {
        entry.data.updatedDate && (
          <>
            <span aria-hidden="true"> · </span>
            {t('common.updatedOn')}{' '}
            <time datetime={isoDate(entry.data.updatedDate)}>
              {formatDate(entry.data.updatedDate, locale)}
            </time>
          </>
        )
      }
    </p>

    {
      entry.data.heroImage && (
        <Image
          src={entry.data.heroImage}
          alt={entry.data.heroImageAlt ?? ''}
          class="border-line mt-10 rounded-md border"
          widths={[400, 800, 1200]}
          sizes="(max-width: 768px) 100vw, 768px"
        />
      )
    }

    <div class="prose-basic mt-10">
      <Content />
    </div>
  </article>
</BaseLayout>
