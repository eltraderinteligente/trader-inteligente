---
import PageLayout from '../../layouts/PageLayout.astro';
import type { Locale } from '../../config/site';
import { useTranslations, alternatesForRoute } from '../../i18n/utils';
import { BOOKS, bookLink, isAffiliate } from '../../data/books';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const placeholder =
  'border-line bg-panel-raised text-muted rounded-md border border-dashed p-5 text-sm';
---

{/*
  No email form on this page. Asking for an address before handing over a PDF
  is the standard trade, but it contradicts the promise made everywhere else
  here — that nothing is dangled in exchange for contact details. The waiting
  list in the footer is where someone volunteers an address, and it asks
  plainly rather than holding a download hostage.
*/}
<PageLayout
  title={t('guides.title')}
  intro={t('guides.intro')}
  alternates={alternatesForRoute('guides')}
>
  <section>
    <h2 class="text-xl font-semibold sm:text-2xl">
      {t('guides.downloadsHeading')}
    </h2>
    <p class={`mt-5 ${placeholder}`}>{t('guides.downloadsEmpty')}</p>
  </section>

  <section class="mt-16">
    <h2 class="text-xl font-semibold sm:text-2xl">
      {t('guides.booksHeading')}
    </h2>
    <p class="text-body mt-4 leading-relaxed">{t('guides.booksIntro')}</p>

    {/*
      The disclosure sits above the links, not in the footer. Footer-only
      disclosure is the single most common way sites lose their Amazon
      account, and the FTC's rule is the same one: it has to be where a
      reader sees it before deciding to click, not somewhere they could
      scroll past. The last line is Amazon's required wording, quoted in
      English exactly as their agreement specifies, on both language versions.
    */}
    {
      isAffiliate && (
        <aside class="border-line bg-panel-raised text-muted mt-6 rounded-md border p-5 text-sm leading-relaxed">
          <p>{t('guides.affiliateDisclosure')}</p>
          <p class="mt-3 italic">
            As an Amazon Associate I earn from qualifying purchases.
          </p>
        </aside>
      )
    }

    {
      BOOKS.length === 0 ? (
        <p class={`mt-6 ${placeholder}`}>{t('guides.booksEmpty')}</p>
      ) : (
        <ul class="border-line divide-line mt-6 divide-y border-t border-b">
          {BOOKS.map((book) => {
            const href = bookLink(book);
            return (
              <li class="py-5">
                <p class="text-heading font-medium">
                  {book.title}
                  <span class="text-muted font-normal">
                    {' '}
                    {t('guides.by')} {book.author}
                  </span>
                </p>
                <p class="text-body mt-2 leading-relaxed">{book.note[locale]}</p>
                {href && (
                  <p class="mt-3 text-sm">
                    {/*
                      rel="sponsored nofollow" is what a paid link is supposed
                      to carry. Google asks for it and it costs nothing.
                    */}
                    <a
                      class="link-quiet underline"
                      href={href}
                      rel="sponsored nofollow noopener"
                      target="_blank"
                    >
                      {t('guides.buyLink')}
                    </a>
                    {isAffiliate && (
                      <span class="text-muted">
                        {' '}
                        {t('guides.affiliateMark')}
                      </span>
                    )}
                  </p>
                )}
              </li>
            );
          })}
        </ul>
      )
    }
  </section>
</PageLayout>
