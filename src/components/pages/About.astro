---
import PageLayout from '../../layouts/PageLayout.astro';
import type { Locale } from '../../config/site';
import {
  useTranslations,
  alternatesForRoute,
  type TranslationKey,
} from '../../i18n/utils';
import { route } from '../../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/**
 * The bio in order of what a reader actually wants to know: who is this, how
 * did he get here, why should I believe the method, what will the classes be
 * like, and what is he refusing to do. The last section exists because the
 * licences are the most credible fact on the site and the easiest to misread
 * as a financial qualification.
 */
const SECTIONS = [
  'story',
  'markets',
  'method',
  'teaching',
  'not',
  'licence',
] as const;
---

<PageLayout
  title={t('about.title')}
  intro={t('about.intro')}
  alternates={alternatesForRoute('about')}
>
  {/*
    A photo belongs here and the page is better with one — a mentorship is
    bought from a person, not a brand. It is left out rather than filled in
    because the only wrong answer is a stranger's face: a stock photo on this
    page would undo everything the rest of it says. The `photoAlt` and
    `photoPending` strings are kept in both locale files, so putting a real
    photo back is a matter of restoring this block.
  */}

  {
    SECTIONS.map((key) => (
      <section class="mt-14">
        <h2 class="text-xl font-semibold sm:text-2xl">
          {t(`about.${key}Heading` as TranslationKey)}
        </h2>
        <p class="text-body mt-4 leading-relaxed">
          {t(`about.${key}` as TranslationKey)}
        </p>
      </section>
    ))
  }

  <section class="border-line mt-16 border-t pt-14">
    <h2 class="text-xl font-semibold sm:text-2xl">{t('about.ctaHeading')}</h2>
    <p class="text-body mt-4 leading-relaxed">{t('about.cta')}</p>
    <a href={route('contact', locale)} class="btn-primary mt-8">
      {t('about.ctaButton')}
    </a>
  </section>
</PageLayout>
