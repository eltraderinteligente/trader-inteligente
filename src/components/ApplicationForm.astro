---
import type { Locale } from '../config/site';
import { useTranslations } from '../i18n/utils';
import { FORMS, HONEYPOT_FIELD, isConfigured } from '../config/forms';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const action = FORMS.contactAction;
const ready = isConfigured(action);

// A form with no destination would look like it worked and silently drop the
// application, so every control is disabled until an endpoint is set.
const disabled = !ready;

/**
 * Nothing here asks how much money someone has, what they earn, or what they
 * intend to risk. Collecting that would make this look like a suitability
 * assessment, which is something an investment adviser does. What is asked is
 * what is needed to put four people in a room at a time that suits them.
 */
const EXPERIENCE = ['None', 'Some', 'Years'] as const;

const field =
  'border-line bg-panel text-body focus:border-accent w-full rounded-md border px-3 py-2 text-sm disabled:opacity-50';
const labelClass = 'text-heading block text-sm font-medium';
const helpClass = 'text-muted mt-1 text-xs';
---

<section aria-labelledby="apply-heading">
  <h2 id="apply-heading" class="text-xl font-semibold sm:text-2xl">
    {t('contact.apply.heading')}
  </h2>
  <p class="text-body mt-4 leading-relaxed">{t('contact.apply.intro')}</p>

  {
    !ready && (
      <p class="border-line bg-panel-raised text-muted mt-6 rounded-md border border-dashed p-4 text-sm">
        {t('contact.apply.notConfigured')}
      </p>
    )
  }

  <form
    class="mt-8 space-y-6"
    method="post"
    action={ready ? action : undefined}
    aria-describedby={ready ? undefined : 'apply-unavailable'}
  >
    {/* Hidden from people, filled in by bots. Discarded by the form service. */}
    <div class="hidden" aria-hidden="true">
      <label for="apply-hp">Company website</label>
      <input
        id="apply-hp"
        type="text"
        name={HONEYPOT_FIELD}
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div>
      <label class={labelClass} for="apply-name">
        {t('contact.apply.form.name')}
      </label>
      <input
        id="apply-name"
        name="name"
        type="text"
        required
        disabled={disabled}
        autocomplete="name"
        class={`mt-2 ${field}`}
      />
      <p class={helpClass}>{t('contact.apply.form.nameHelp')}</p>
    </div>

    <div>
      <label class={labelClass} for="apply-email">
        {t('contact.apply.form.email')}
      </label>
      <input
        id="apply-email"
        name="email"
        type="email"
        required
        disabled={disabled}
        autocomplete="email"
        class={`mt-2 ${field}`}
      />
      <p class={helpClass}>{t('contact.apply.form.emailHelp')}</p>
    </div>

    {/*
      Asked rather than assumed from the page language. Someone can read the
      Spanish site and still want the English group, and the two groups never
      share a session.
    */}
    <fieldset disabled={disabled}>
      <legend class={labelClass}>{t('contact.apply.form.language')}</legend>
      <div class="mt-2 flex flex-wrap gap-4">
        <label class="text-body flex items-center gap-2 text-sm">
          <input
            type="radio"
            name="language"
            value="es"
            required
            checked={locale === 'es'}
            class="accent-action"
          />
          {t('contact.apply.form.languageEs')}
        </label>
        <label class="text-body flex items-center gap-2 text-sm">
          <input
            type="radio"
            name="language"
            value="en"
            required
            checked={locale === 'en'}
            class="accent-action"
          />
          {t('contact.apply.form.languageEn')}
        </label>
      </div>
      <p class={helpClass}>{t('contact.apply.form.languageHelp')}</p>
    </fieldset>

    <div>
      <label class={labelClass} for="apply-location">
        {t('contact.apply.form.location')}
      </label>
      <input
        id="apply-location"
        name="location"
        type="text"
        required
        disabled={disabled}
        autocomplete="country-name"
        class={`mt-2 ${field}`}
      />
      <p class={helpClass}>{t('contact.apply.form.locationHelp')}</p>
    </div>

    <fieldset disabled={disabled}>
      <legend class={labelClass}>{t('contact.apply.form.experience')}</legend>
      <div class="mt-2 space-y-2">
        {
          EXPERIENCE.map((level) => (
            <label class="text-body flex items-center gap-2 text-sm">
              <input
                type="radio"
                name="experience"
                value={level.toLowerCase()}
                required
                class="accent-action"
              />
              {t(`contact.apply.form.experience${level}`)}
            </label>
          ))
        }
      </div>
      <p class={helpClass}>{t('contact.apply.form.experienceHelp')}</p>
    </fieldset>

    <div>
      <label class={labelClass} for="apply-goal">
        {t('contact.apply.form.goal')}
      </label>
      <textarea
        id="apply-goal"
        name="goal"
        rows="5"
        required
        disabled={disabled}
        class={`mt-2 ${field}`}></textarea>
      <p class={helpClass}>{t('contact.apply.form.goalHelp')}</p>
    </div>

    <div>
      <label class={labelClass} for="apply-availability">
        {t('contact.apply.form.availability')}
      </label>
      <input
        id="apply-availability"
        name="availability"
        type="text"
        required
        disabled={disabled}
        class={`mt-2 ${field}`}
      />
      <p class={helpClass}>{t('contact.apply.form.availabilityHelp')}</p>
    </div>

    {/*
      Consent is scoped to answering this application and nothing else. A
      broader "I agree to receive communications" here would quietly turn an
      application into a mailing-list signup.
    */}
    <div>
      <label class="text-body flex items-start gap-3 text-sm">
        <input
          type="checkbox"
          name="consent"
          value="yes"
          required
          disabled={disabled}
          class="accent-action mt-1"
        />
        <span>{t('contact.apply.form.consent')}</span>
      </label>
      <p class={`${helpClass} ml-7`}>{t('contact.apply.form.consentHelp')}</p>
    </div>

    <button
      type="submit"
      disabled={disabled}
      class="btn-primary disabled:opacity-50"
    >
      {t('contact.apply.form.submit')}
    </button>

    {
      !ready && (
        <p id="apply-unavailable" class="sr-only">
          {t('contact.apply.notConfigured')}
        </p>
      )
    }
  </form>
</section>
