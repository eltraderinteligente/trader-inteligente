---
import type { Locale } from '../config/site';
import { useTranslations, type TranslationKey } from '../i18n/utils';

interface Props {
  locale: Locale;
  /** Keys under `faq.items` in the translation files. */
  items: readonly string[];
}

const { locale, items } = Astro.props;
const t = useTranslations(locale);
---

{/*
  Built on <details>/<summary>, which is plain HTML — it opens and closes with
  no JavaScript at all. That matters twice over: the page still works if a
  script fails, and every answer sits in the HTML source, so a search engine
  reads the full text whether or not the question is open on screen.
*/}
<div class="border-line divide-line divide-y border-t border-b">
  {
    items.map((key) => (
      <details class="group">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-5 py-5 [&::-webkit-details-marker]:hidden">
          <h3 class="text-heading group-hover:decoration-accent text-base font-medium underline-offset-4 group-hover:underline">
            {t(`faq.items.${key}.q` as TranslationKey)}
          </h3>
          {/*
            A rotating plus rather than a chevron image: one character, no
            asset to load, and it reads as open/closed at any text size.
          */}
          <span
            class="text-muted group-open:text-accent mt-0.5 shrink-0 text-lg leading-none transition-transform duration-200 group-open:rotate-45"
            aria-hidden="true"
          >
            +
          </span>
        </summary>
        <p class="text-body max-w-2xl pb-6 leading-relaxed">
          {t(`faq.items.${key}.a` as TranslationKey)}
        </p>
      </details>
    ))
  }
</div>
